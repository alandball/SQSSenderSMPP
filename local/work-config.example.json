    "EnquireLinkSeconds": 30
  },
  "Sender": {
    "PerBindTps": 10,
    "Window": 10,
    "MaxActiveEnvelopes": 16,
    "VisibilitySeconds": 120,
    "HeartbeatSeconds": 30,
    "LeaseSeconds": 60,
    "ShutdownSeconds": 105
  },
  "Telemetry": { "EnableOtlp": true }
