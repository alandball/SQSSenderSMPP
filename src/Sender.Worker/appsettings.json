{
  "Urls": "http://127.0.0.1:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Telemetry": { "EnableOtlp": false },
  "Sender": {
    "MaxActiveEnvelopes": 16,
    "Window": 10,
    "PerBindTps": 10,
    "VisibilitySeconds": 120,
    "HeartbeatSeconds": 30,
    "LeaseSeconds": 60,
    "MaxAttempts": 5,
    "RetentionDays": 30,
    "ShutdownSeconds": 105
  }
}
